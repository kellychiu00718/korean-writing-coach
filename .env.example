# 複製成 .env.local 再填值（.env.local 不會進 git）

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 同一頁的 service_role（secret）金鑰：只給伺服器寫入資料用，絕對不要加 NEXT_PUBLIC_ 前綴
SUPABASE_SERVICE_ROLE_KEY=

# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# 句子回饋用的模型與每人每日 AI 次數上限
COACH_MODEL=claude-haiku-5-5
COACH_EFFORT=medium
DAILY_AI_LIMIT=30

# 全站每天最多呼叫幾次 AI（所有使用者加起來），避免費用被刷爆
GLOBAL_DAILY_AI_LIMIT=300

# 出錯時寄信通知（Resend → API Keys）；收件人是你自己的信箱，寄件人要用 Resend 驗證過的網域
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
